subscription_id = "00000000-0000-0000-0000-000000000000"
region          = "eastus2"
region_aifoundry = "eastus2"
region_search    = "eastus"
name_prefix       = "cadence"

frontend_app_client_id = "00000000-0000-0000-0000-000000000000"
azure_ad_allowed_tenant_ids = [
  "00000000-0000-0000-0000-000000000000",
  "11111111-1111-1111-1111-111111111111"
]

# Existing GitHub OIDC federated service principal used by private-runner and CI/CD workflows.
github_federated_principal_object_id = "00000000-0000-0000-0000-000000000000"
github_federated_principal_client_id = "00000000-0000-0000-0000-000000000000"

# Optional SQL Entra admin override (recommended: Entra group object ID + display name).
# Prerequisite: run `bash ./infra/scripts/ensure-sql-admin-group.sh` to create/verify
# a shared admin group and print the values to copy below.
# sql_azuread_admin_object_id      = "00000000-0000-0000-0000-000000000000"
# sql_azuread_admin_login_username = "cadence-sql-admins"

resource_group_name             = null
vnet_address_space              = ["10.40.0.0/16"]
private_endpoints_subnet_cidr   = "10.40.0.0/24"
application_subnet_cidr         = "10.40.1.0/24"
data_subnet_cidr                = "10.40.2.0/24"
container_apps_subnet_cidr      = "10.40.3.0/23"
utility_subnet_cidr             = "10.40.4.0/24"
ai_agent_services_subnet_cidr   = "10.40.5.0/24"
bastion_subnet_cidr             = "10.40.6.0/26"

utility_vm_admin_password        = "<replace-with-strong-password>"
utility_vm_size                  = "Standard_D4s_v3"

sql_database_name               = "WideWorldImportersStd"
enable_local_exec_provisioning = false

private_dns_zone_names = [
  "privatelink.azurecr.io",
  "privatelink.blob.core.windows.net",
  "privatelink.openai.azure.com",
  "privatelink.cognitiveservices.azure.com",
  "privatelink.services.ai.azure.com",
  "privatelink.database.windows.net",
  "privatelink.documents.azure.com",
  "privatelink.search.windows.net",
  "privatelink.vaultcore.azure.net"
]

tags = {
  Environment = "Dev"
  Owner       = "your-name"
  Workload    = "cadence"
}
