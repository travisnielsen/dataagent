#!/usr/bin/env bash
#
# Pre-commit hook
# Runs code quality checks before allowing a commit
#

set -euo pipefail

MODE="${1:-}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Ensure uv is in PATH (for VS Code and other GUI git clients)
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:$PATH"

validate_branch_policy() {
    # Protected branches
    local protected_branches=("main" "master")
    local current_branch
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

    # Detached HEAD: no branch policy check required.
    if [[ -z "$current_branch" ]]; then
        return 0
    fi

    for branch in "${protected_branches[@]}"; do
        if [[ "$current_branch" == "$branch" ]]; then
            echo -e "${RED}Error: Direct commits to '$branch' are not allowed!${NC}"
            echo ""
            echo "Please create a feature branch and submit a pull request:"
            echo "  git checkout -b feat/<short-description>"
            echo ""
            return 1
        fi
    done

    local docs_short_pattern='^docs/[a-z0-9]+(-[a-z0-9]+)*$'
    local typed_optional_ticket_pattern='^[a-z][a-z0-9-]*/([0-9]+-)?[a-z0-9]+(-[a-z0-9]+)*$'
    # Spec Kit native naming: sequential (e.g. 007-foundry-agent-threads)
    # or timestamp (e.g. 20260319-143022-foundry-agent-threads).
    local speckit_sequential_pattern='^[0-9]{3,}-[a-z0-9]+(-[a-z0-9]+)*$'
    local speckit_timestamp_pattern='^[0-9]{8}-[0-9]{6}-[a-z0-9]+(-[a-z0-9]+)*$'

    if [[ "$current_branch" =~ $docs_short_pattern \
        || "$current_branch" =~ $typed_optional_ticket_pattern \
        || "$current_branch" =~ $speckit_sequential_pattern \
        || "$current_branch" =~ $speckit_timestamp_pattern ]]; then
        return 0
    fi

    echo -e "${RED}Error: Branch name '$current_branch' does not match repository policy.${NC}"
    echo ""
    echo "Allowed patterns:"
    echo "  <type>/<short-description>              (manual branches)"
    echo "  <type>/<ticket>-<short-description>     (manual branches with ticket)"
    echo "  docs/<short-description>                (docs-only shortcut)"
    echo "  NNN-<short-description>                 (Spec Kit sequential)"
    echo "  YYYYMMDD-HHMMSS-<short-description>     (Spec Kit timestamp)"
    echo ""
    echo "Examples:"
    echo "  feat/template-matching"
    echo "  feat/123-template-matching"
    echo "  fix/456-null-response"
    echo "  docs/readme-update"
    echo "  007-foundry-agent-threads"
    echo ""
    return 1
}

validate_branch_policy

if [[ "$MODE" == "--validate-branch" ]]; then
    echo -e "${GREEN}Branch policy check passed!${NC}"
    exit 0
fi

echo -e "${YELLOW}Running pre-commit checks...${NC}"

if ! command -v uv &> /dev/null; then
    echo -e "${RED}Error: uv is not installed${NC}"
    exit 1
fi

if command -v prek &> /dev/null || uv run prek --version &> /dev/null 2>&1; then
    prek run --hook-stage pre-commit 2>/dev/null || uv run prek run --hook-stage pre-commit || {
        echo -e "${RED}Pre-commit checks failed. Please fix the issues and try again.${NC}"
        exit 1
    }
else
    echo "Running ruff format check..."
    uv run ruff format --check src tests 2>/dev/null || {
        echo -e "${RED}Formatting issues found. Run 'uv run poe format' to fix.${NC}"
        exit 1
    }

    echo "Running ruff lint..."
    uv run ruff check src tests 2>/dev/null || {
        echo -e "${RED}Linting issues found. Run 'uv run poe lint' to fix.${NC}"
        exit 1
    }
fi

echo -e "${GREEN}Pre-commit checks passed!${NC}"
