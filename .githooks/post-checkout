#!/usr/bin/env bash
#
# Post-checkout hook
# Validates branch policy whenever switching to a branch (including newly created branches)
#

set -euo pipefail

# Args from git:
#   $1 previous HEAD
#   $2 new HEAD
#   $3 1 if a branch was checked out, 0 if a file checkout occurred
if [[ "${3:-0}" != "1" ]]; then
  exit 0
fi

HOOK_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PRE_COMMIT_HOOK="$HOOK_DIR/pre-commit"

if [[ -x "$PRE_COMMIT_HOOK" ]]; then
  "$PRE_COMMIT_HOOK" --validate-branch
fi
