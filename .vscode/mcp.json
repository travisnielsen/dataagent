{
  "servers": {
    "assistant-ui": {
      "command": "npx",
      "args": [
        "-y",
        "@assistant-ui/mcp-docs-server"
      ]
    },
    "foundry-mcp-remote": {
      "type": "http",
      "url": "https://mcp.ai.azure.com"
    },
    "awesome-copilot": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:latest"
      ]
    }
  }
}
