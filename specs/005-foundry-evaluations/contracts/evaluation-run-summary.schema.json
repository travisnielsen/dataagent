{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EvaluationRunSummary",
    "description": "Summary output from an evaluation run",
    "type": "object",
    "required": [
        "run_id",
        "status",
        "metrics",
        "total_records",
        "overall_pass"
    ],
    "properties": {
        "run_id": {
            "type": "string",
            "description": "Unique evaluation run identifier"
        },
        "eval_id": {
            "type": [
                "string",
                "null"
            ],
            "description": "Foundry evaluation ID for cloud runs"
        },
        "dataset_name": {
            "type": "string"
        },
        "dataset_version": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "running",
                "completed",
                "failed",
                "cancelled"
            ]
        },
        "trigger": {
            "type": "string",
            "enum": [
                "ci_pr",
                "nightly",
                "manual"
            ]
        },
        "started_at": {
            "type": "string",
            "format": "date-time"
        },
        "completed_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        },
        "git_sha": {
            "type": [
                "string",
                "null"
            ]
        },
        "branch": {
            "type": [
                "string",
                "null"
            ]
        },
        "metrics": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/MetricResult"
            }
        },
        "total_records": {
            "type": "integer",
            "minimum": 0
        },
        "total_passed": {
            "type": "integer",
            "minimum": 0
        },
        "total_failed": {
            "type": "integer",
            "minimum": 0
        },
        "overall_pass": {
            "type": "boolean"
        },
        "failure_count_by_cluster": {
            "type": "object",
            "additionalProperties": {
                "type": "integer"
            }
        },
        "gate_decision": {
            "$ref": "#/definitions/QualityGateDecision"
        }
    },
    "definitions": {
        "MetricResult": {
            "type": "object",
            "required": [
                "metric",
                "mean_score",
                "pass_rate",
                "sample_count"
            ],
            "properties": {
                "metric": {
                    "type": "string"
                },
                "mean_score": {
                    "type": "number"
                },
                "median_score": {
                    "type": "number"
                },
                "p5_score": {
                    "type": "number"
                },
                "p95_score": {
                    "type": "number"
                },
                "pass_rate": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0
                },
                "sample_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "threshold": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "passed": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                }
            }
        },
        "QualityGateDecision": {
            "type": "object",
            "required": [
                "gate_result",
                "decided_at"
            ],
            "properties": {
                "gate_result": {
                    "type": "string",
                    "enum": [
                        "pass",
                        "fail",
                        "error"
                    ]
                },
                "failing_metrics": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "waivers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "decided_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        }
    },
    "additionalProperties": false
}
